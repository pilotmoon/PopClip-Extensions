{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "types": ["@popclip/types"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
  },
  "include": ["./lib", "./source", "./contrib"],
}
